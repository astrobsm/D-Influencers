PORT=3000

# ── Local Postgres (development) ────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dinfluencers_hub
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# ── Supabase / Production (use this OR the discrete vars above) ─
# Supabase: Project Settings → Database → Connection string → URI
# Use the "Transaction" pooler URI (port 6543) for serverless / Vercel.
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
